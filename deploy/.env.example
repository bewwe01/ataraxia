# Copy to deploy/.env (never commit .env). See deploy/README.md.

# Address clients use to reach coturn, as public-ip or public-ip/private-ip when behind NAT
# (e.g. 203.0.113.10/192.168.1.20 for a Raspberry Pi behind a home router).
TURN_EXTERNAL_IP=203.0.113.10

# TURN URLs handed to clients (1-4, comma-separated). Use the same host as TURN_EXTERNAL_IP.
VEIL_TURN_URLS=turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp

# Disk caps (MB) for queued messages and attachments. Budget about 3.5x their sum for the
# database file (measured: apparent size 3.4x, allocated about 2x), so ~18 GB free for the
# defaults. Lower them on a small SD card.
VEIL_QUOTA_ENVELOPES_MB=1024
VEIL_QUOTA_BLOBS_MB=4096

# Database page cache (MB): most of the relay's memory. 64 keeps it near 100 MB in total.
VEIL_DB_CACHE_MB=64

# Concurrent connections per client address (IPv4) or /64 (IPv6). If clients reach the relay
# through something that hides their address (a reverse proxy, or Docker's userland proxy for
# IPv6 clients of this IPv4-only container), they all count as one source: raise this.
VEIL_MAX_CONN_PER_SOURCE=32

# error | warn | info | debug. No level logs client data.
VEIL_LOG=info
