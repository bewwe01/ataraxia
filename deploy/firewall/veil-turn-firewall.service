# Loads /etc/veil-turn.nft at boot, before Docker. See deploy/firewall/veil-turn.nft and
# deploy/README.md.
#
# Two drop-ins complete it:
# - nftables-veil-turn.conf makes nftables.service itself re-load the rule after it starts,
#   reloads and stops (Debian's /etc/nftables.conf begins with `flush ruleset`; review P3R4-3);
# - docker-veil-turn.conf makes Docker load the rule when it starts, and refuse to start if it
#   cannot (no RequiredBy=: stopping this unit never stops Docker; review P3R3-5, P3R4-2).
[Unit]
Description=Veil: keep coturn from relaying into this host's services
DefaultDependencies=no
After=nftables.service
Before=network-pre.target docker.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/veil-turn.nft
ExecReload=/usr/sbin/nft -f /etc/veil-turn.nft
ExecStop=-/usr/sbin/nft delete table inet veil_turn

[Install]
WantedBy=multi-user.target
