{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil WebRTC Probe",
  "version": "0.0.1",
  "identifier": "org.veil.spike.webrtcprobe",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
